# Copie para .env.local e preencha (nunca commite .env.local).

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=

# Cliente (escolha UMA das duas — conforme o painel do Supabase):
# Nova: Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legada: aba "Legacy anon, service_role" (eyJ...)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Servidor — upload de vídeo/áudio, convites, admin (NUNCA no frontend):
# Nova: Secret key (sb_secret_...) — botão "Reveal" na secção Secret keys
SUPABASE_SECRET_KEY=
# Legada: service_role (eyJ...) — aba "Legacy anon, service_role API keys"
# SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (links de convite, reset de senha, magic link)
# Produção: https://seu-dominio.com  |  Dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Groq — APIs de geração e refinamento
GROQ_API_KEY=

# Opcional: e-mail de suporte na página de configurações
# NEXT_PUBLIC_SUPPORT_EMAIL=suporte@empresa.com

# Opcional (recomendado): envio de confirmação de cadastro via Resend
# Domínio verificado em https://resend.com/domains
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=SpecFlow <noreply@seudominio.com>

# Na Vercel, NEXT_PUBLIC_SITE_URL costuma ser definida manualmente.
# VERCEL_URL é injetada automaticamente e usada como fallback em alguns fluxos.
